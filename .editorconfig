root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,toml,md,json}]
indent_size = 2

# Markdown: a trailing double space can be a line break
[*.md]
trim_trailing_whitespace = false

# Test data whose exact bytes matter (line endings, BOMs, trailing spaces, a missing final newline): never rewrite it
[{eval/corpus/**,eval/holdout/**,tests/snapshots/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
